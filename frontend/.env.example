# Base URL for Riya's FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to develop Joy's operator screens against lib/mockData.ts
# instead of the real backend. Flip off once /queue and /cases/{id} are
# live (target: ~18h checkpoint per the integration brief).
NEXT_PUBLIC_USE_MOCKS=true
